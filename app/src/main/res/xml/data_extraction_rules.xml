<?xml version="1.0" encoding="utf-8"?>
<!-- Attenora keeps nothing: no backup, no device-to-device transfer.
     Uninstalling the app removes it and every trace of its data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
