<?xml version="1.0" encoding="utf-8"?>
<!-- Attenora brand mark foreground: the meandering 'A' ribbon. The big
     ribbon carries the mist-to-teal gradient of the logo; the shorter inner
     ribbon is the mist crossing. Adaptive safe zone: the mark spans
     x30..x80, y26..y88 of 108. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M30,88 C36,46 44,26 55,26 C66,26 74,50 80,88"
        android:strokeWidth="15"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30" android:startY="26"
                android:endX="80" android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD6E2DD" />
                <item android:offset="1.0" android:color="#FF3E827D" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M42,88 C46,62 50,48 56,48 C62,48 66,64 69,88"
        android:strokeColor="#FFD6E2DD"
        android:strokeWidth="15"
        android:strokeLineCap="round" />
</vector>
